pipeline {

    agent any

    environment {
        SONAR_PROJECT_KEY  = "tyranitor"
        SONAR_PROJECT_NAME = "Tyranitor Project"
        SONAR_HOST_URL     = "http://sonarqube:9000"
        COVERAGE_THRESHOLD = "60"
        REPORTS_DIR        = "reports"
        APP_NAME = "tyranitor"
    }

    stages {

        stage("1 · Checkout") {
            steps {
                checkout scm
                sh "ls -la"
            }
        }

        stage("2 · Preparar entorno") {
            steps {
                sh """
                    python3 -m venv venv
                    . venv/bin/activate

                    pip install --upgrade pip
                    pip install --no-cache-dir -r sqp/requirements.txt

                    mkdir -p ${REPORTS_DIR}
                """
            }
        }

        stage("3 · Pruebas unitarias") {
            steps {
                sh """
                    . venv/bin/activate

                    pytest sqp \
                      --cov=sqp \
                      --cov-report=xml:${REPORTS_DIR}/coverage.xml \
                      --cov-report=html:${REPORTS_DIR}/html \
                      --cov-fail-under=${COVERAGE_THRESHOLD} \
                      --junitxml=${REPORTS_DIR}/junit.xml
                """
            }
            post {
                always {
                    junit "${REPORTS_DIR}/junit.xml"
                }
            }
        }

        stage("4 · Análisis SonarQube") {
            steps {
                withSonarQubeEnv("SonarQube") {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        sh """
                            . venv/bin/activate

                            ${scannerHome}/bin/sonar-scanner \
                              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                              -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                              -Dsonar.sources=sqp/src \
                              -Dsonar.tests=sqp/tests \
                              -Dsonar.exclusions=**/__pycache__/**,**/*.pyc \
                              -Dsonar.python.coverage.reportPaths=${REPORTS_DIR}/coverage.xml \
                              -Dsonar.host.url=${SONAR_HOST_URL} \
                              -Dsonar.python.version=3
                        """
                    }
                }
            }
        }

        stage("5 · Quality Gate") {
            steps {
                script {
                    timeout(time: 10, unit: 'MINUTES') {
                        def qg = waitForQualityGate()
                        echo "Quality Gate: ${qg.status}"
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finalizado: ${currentBuild.currentResult}"
        }
        success {
            echo "Build exitoso 🚀"
        }
        failure {
            echo "Fallo en pipeline ❌"
        }
    }
}
